# Служебные файлы репозитория не должны быть доступны из браузера:
# внутренние заметки, вёрстка чек-листа и папка .git с историей проекта.
RedirectMatch 404 /\.git
<FilesMatch "\.(md|MD)$">
  Require all denied
</FilesMatch>
<Files "checklist.html">
  Require all denied
</Files>

# config.php с токеном бота: PHP-файлы наружу не отдаются, но если PHP
# на сервере вдруг отвалится, файл уйдёт посетителю простым текстом.
<FilesMatch "^config([.]example)?[.]php$">
  Require all denied
</FilesMatch>

# Единый адрес: без www. Редирект на https добавим после выпуска
# SSL-сертификата — раньше он уведёт посетителей на неработающий адрес.
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ http://%1/$1 [L,R=301]

# Папка с заявками: в CSV лежат телефоны гостей и ответы про здоровье.
# lead.php кладёт внутрь свой .htaccess при первой заявке, но если папку
# создадут вручную или сервер окажется на nginx, эта защита не сработает —
# поэтому закрываем ещё и отсюда.
RedirectMatch 404 ^/leads(/|$)

# ── ВКЛЮЧИТЬ ПОСЛЕ ВЫПУСКА SSL-СЕРТИФИКАТА ───────────────────────────
# Убрать «#» у трёх строк ниже. До этого момента формы уходят открытым
# текстом, а политика конфиденциальности (п. 11) обещает HTTPS —
# без этого редиректа обещание не выполняется.
# RewriteCond %{HTTPS} !=on
# RewriteCond %{HTTP:X-Forwarded-Proto} !https
# RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]
