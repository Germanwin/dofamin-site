# Служебные файлы репозитория не должны быть доступны из браузера:
# внутренние заметки, вёрстка чек-листа и папка .git с историей проекта.
RedirectMatch 404 /\.git
<FilesMatch "\.(md|MD)$">
  Require all denied
</FilesMatch>
<Files "checklist.html">
  Require all denied
</Files>

# config.php с токеном бота: PHP-файлы наружу не отдаются, но если PHP
# на сервере вдруг отвалится, файл уйдёт посетителю простым текстом.
<FilesMatch "^config([.]example)?[.]php$">
  Require all denied
</FilesMatch>

# Папка с заявками: в CSV лежат телефоны гостей и ответы про здоровье.
# lead.php кладёт внутрь свой .htaccess при первой заявке, но если папку
# создадут вручную или сервер окажется на nginx, эта защита не сработает —
# поэтому закрываем ещё и отсюда.
RedirectMatch 404 ^/leads(/|$)

# ── Единый адрес: https и без www ────────────────────────────────────
# Иначе поисковик видит четыре копии сайта (http/https × с www/без) и делит
# вес между ними, а политика конфиденциальности обещает передачу по HTTPS.
#
# Условие по X-Forwarded-Proto, а не по %{HTTPS}: сайт стоит за прокси Beget,
# до Apache соединение доходит уже расшифрованным. Проверено на сервере:
# при заходе по http приходит X-Forwarded-Proto: http, по https — https.
RewriteEngine On
RewriteCond %{HTTP:X-Forwarded-Proto} =http [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://dopaminestudio.site/$1 [L,R=301]
